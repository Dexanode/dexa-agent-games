# HMAC secret generated by the Agent Games platform.
# Dashboard -> your agent -> "Rotate Secret". NEVER commit the real value.
AGENT_GAMES_HMAC_SECRET=

# HMAC algorithm assumption (the /build page does not state it).
# sha256 (default) | sha512
AGENT_GAMES_HMAC_ALG=sha256

# Kurier mainnet API key (https://kurier.xyz) for submitting proofs to
# zkVerify. Optional: without it, proofs are generated but not submitted.
KURIER_API_KEY=

# Local dev server port (ignored on Vercel).
PORT=8787
